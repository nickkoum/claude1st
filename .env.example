# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Sender identity ───────────────────────────────────────────────────────────
SENDER_EMAIL=outreach@yourdomain.com
SENDER_DISPLAY_NAME=Nikos from YourCompany
SENDER_FIRST_NAME=Nikos

# ── GoHighLevel CRM ───────────────────────────────────────────────────────────
GHL_API_KEY=your-ghl-api-key
GHL_LOCATION_ID=your-ghl-location-id
GHL_USER_ID=your-ghl-user-id
GHL_PIPELINE_ID=your-pipeline-id
GHL_STAGE_EMAILED_ID=stage-id-for-emailed-awaiting-reply
GHL_STAGE_REPLIED_ID=stage-id-for-replied-needs-human
GHL_STAGE_COMPLETE_ID=stage-id-for-sequence-complete-no-reply

# ── Internal notifications ────────────────────────────────────────────────────
NOTIFICATION_EMAIL=you@yourdomain.com

# ── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=outreach@yourdomain.com
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
